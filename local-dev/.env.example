# ============================================================
# local-dev environment overrides
# Copy to .env (same directory) to customise service config.
# The Makefile sources this file automatically.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=dongle
POSTGRES_PASSWORD=dongle_dev_pass
POSTGRES_DB=dongle_dev
# Connection string consumed by the seed script and future backend
DATABASE_URL=postgresql://dongle:dongle_dev_pass@localhost:5432/dongle_dev

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=dongle_dev_redis
REDIS_URL=redis://:dongle_dev_redis@localhost:6379

# ── Stellar (local standalone network) ──────────────────────
# Horizon REST API
STELLAR_HORIZON_URL=http://localhost:8000
# Soroban RPC endpoint — consumed by dongle/.env.local
SOROBAN_RPC_URL=http://localhost:8001
# Standalone network passphrase (fixed for stellar/quickstart standalone mode)
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
# Friendbot endpoint
STELLAR_FRIENDBOT_URL=http://localhost:8002/friendbot

# ── IPFS ─────────────────────────────────────────────────────
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# ── Seed accounts (pre-funded test wallets) ──────────────────
# These are well-known TEST ONLY keys — never use in production or mainnet.
SEED_ADMIN_SECRET=SCZANGBA5RLPPI7MRZIF6KDWWTHMJGKQK6VLDXM7XHEKIEGPNLZB7XV
SEED_USER1_SECRET=SCQWZWSAZDVMMM5PBZFVXVBVNMBBHRQHV3MHYPVHOCEMQZJSNDLZXVBA
SEED_USER2_SECRET=SDYBQOQXCMDUVXODLMXOEFQHKNBZM4UFHQJKFHWJ4LDQVLHFQZWTMB6
