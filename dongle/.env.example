# Copy this file to `.env.local` in the `dongle/` directory and customize as needed.
# See README.md "Environment Variables" and DEPLOYMENT.md for production checklist.
# Run `npm run validate:env` before promoting a preview — placeholders fail that check.

# ============================================
# SOROBAN SMART CONTRACTS (required in production)
# ============================================
# Stellar contract IDs (56 chars: C + 55 base32 characters).
# Development builds use placeholder defaults when unset.

NEXT_PUBLIC_PROJECT_REGISTRY_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
NEXT_PUBLIC_REVIEW_REGISTRY_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
NEXT_PUBLIC_VERIFICATION_REGISTRY_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ============================================
# STELLAR NETWORK CONFIGURATION (optional in dev)
# ============================================
# Soroban RPC endpoint. Default: Stellar testnet.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443

# Network passphrase — must match the Freighter network selection.
NEXT_PUBLIC_SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ============================================
# REVIEW PERSISTENCE (optional, dev only)
# ============================================
# Set to "api" to use the server-side API route persistence layer.
# When unset or set to anything else, reviews are stored in localStorage (dev-only).
# API mode requires the Next.js server to be running and uses in-memory storage
# (or a connected database in production).
# Default: localStorage (DEV-ONLY — does not persist across browsers/devices)
NEXT_PUBLIC_REVIEW_PERSISTENCE=

# ============================================
# ADMIN ACCESS CONTROL (optional)
# ============================================
# Comma-separated Stellar public keys (G...) allowed to use the admin dashboard.
# Leave empty to disable admin-only routes.
NEXT_PUBLIC_ADMIN_ALLOWLIST=

# Server-side admin allowlist (NOT exposed to client bundle).
# This is the source of truth for admin authentication.
ADMIN_ALLOWLIST=

# Secret key for signing admin JWT tokens (server-side only).
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# ============================================
# PRODUCT ANALYTICS (optional)
# ============================================
# Privacy-conscious client analytics for core journeys (wallet, discover, submit,
# verify, review). See ANALYTICS_TRACKING_PLAN.md.
# Set to "false" to disable all analytics emission.
NEXT_PUBLIC_ANALYTICS_ENABLED=
# Optional HTTPS ingest endpoint that accepts POST JSON event payloads.
# When unset, events are only logged in development via console.debug.
NEXT_PUBLIC_ANALYTICS_INGEST_URL=

# ============================================
# APPLICATION URL (OAuth redirects + shareable links)
# ============================================
# Canonical origin used for OAuth callback URLs. Do not include a trailing slash.
# Local default: http://localhost:3000
AUTH_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign application session cookies (OAuth). Server-side only.
# Generate with: openssl rand -hex 32
# Never prefix this with NEXT_PUBLIC_.
AUTH_SESSION_SECRET=

# ============================================
# GOOGLE OAUTH (optional — read-only social login)
# ============================================
# Create a Web application client in Google Cloud Console.
# Authorized redirect URI: {AUTH_APP_URL}/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID is used only on the server when starting the OAuth redirect.
GOOGLE_CLIENT_ID=
# Server-side only. Never expose via NEXT_PUBLIC_*.
GOOGLE_CLIENT_SECRET=

# ============================================
# GITHUB OAUTH (optional — read-only social login)
# ============================================
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: {AUTH_APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
# Server-side only. Never expose via NEXT_PUBLIC_*.
GITHUB_CLIENT_SECRET=

# ============================================
# CRON / ANALYTICS AGGREGATION
# ============================================
# Optional bearer token required by GET /api/cron/analytics (00:00 UTC).
# Vercel Cron sends this automatically when configured in the project.
CRON_SECRET=

